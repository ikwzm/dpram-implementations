---
- - [MASTER]
  - SAY : "AXI MWDPRAM 64x32 R1W4WF MODEL TEST BENCH 3.1"
  - AW:                                   # Write Address Channel Action.
    - VALID  : 0                          # AWVALID <= 0
    - WAIT   : 10                         # wait 10 clock
      ADDR   : 0x00000000                 # AWADDR  <= 0x00000000
      SIZE   : 2                          # AWSIZE  <= 2
      LEN    : 1                          # AWLEN   <= 8'h00
      VALID  : 1                          # AWVALID <= 1
    - WAIT   : {VALID : 1, READY : 1}     # wait until AWVALID = 1 and AWREADY = 1
    - VALID  : 0                          # AWVALID <= 0
  - W:                                    # Write Data Channel Action.
    - DATA   : 0                          # WDATA  <= "32'h00000000"
      STRB   : 0                          # WSTRB  <= "4'b0000"
      LAST   : 0                          # WLAST  <= 0
      VALID  : 0                          # WVALID <= 0
    - WAIT   : {AWVALID: 1, ON: on}       # wait until AWVALID = 1 
    - DATA   : "32'h00000010"             # WDATA  <= "32'h00000010"
      STRB   : "4'b0001"                  # WSTRB  <= "4'b0001"
      LAST   : 1                          # WLAST  <= 1
      VALID  : 1                          # WVALID <= 1
    - WAIT   : {VALID: 1, READY: 1}       # wait until WVALID = 1 and WREADY = 1
    - WVALID : 0                          # WVALID <= 0
  - B:                                    # Write Responce Channel Action.
    - READY  : 0                          # BREADY <= 0
    - WAIT   : {AWVALID: 1, AWREADY: 1}   # wait until AWVALID = 1 and AWREADY = 1
    - READY  : 1                          # BREADY <= 1
    - WAIT   : {VALID: 1, READY: 1}       # wait until BVALID = 1 and BREADY = 1
    - CHECK  :                            # CHECK 
        RESP : OKAY                       #   RESP=OKAY
    - READY  : 0                          # BREADY <= 0
  - AR:                                   # Read Address Channel Action.
    - VALID  : 0                          # ARVALID <= 0
    - WAIT   : 10                         # wait 10 clock
      ADDR   : 0x00000000                 # ARADDR  <= 0x00000000
      SIZE   : 2                          # ARSIZE  <= 2
      LEN    : 1                          # ARLEN   <= 8'h00
      VALID  : 1                          # ARVALID <= 1
    - WAIT   : {VALID : 1, READY : 1}     # wait until ARVALID = 1 and ARREADY = 1
    - VALID  : 0                          # ARVALID <= 0
  - R:
    - RREADY : 0                          # RREADY <= 0
    - WAIT   : {ARVALID: 1, ON: on}       # wait until ARVALID = 1 
    - RREADY : 1                          # RREADY <= 1
    - WAIT   : {RVALID: 1, RREADY: 1}     # wait until RVALID = 1 and RREADY = 1
    - CHECK  :                            # CHECK 
        RDATA   : "32'h03020110"          #  RDATA="32'h03020110"
        RLAST   : 1                       #  RLAST=1
        RRESP   : OKAY                    #  RESP=OKAY
    - RREADY : 0                          # RREADY <= 0
